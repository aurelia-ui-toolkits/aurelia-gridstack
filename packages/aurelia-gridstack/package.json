{
  "name": "aurelia-gridstack",
  "version": "8.0.1",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Aurelia 2 wrappers for GridStack",
  "keywords": [
    "aurelia",
    "elements",
    "gridstack"
  ],
  "homepage": "https://aurelia-ui-toolkits.github.io/aurelia-gridstack/",
  "bugs": {
    "url": "https://github.com/aurelia-ui-toolkits/aurelia-gridstack/issues"
  },
  "license": "MIT",
  "author": "https://github.com/maximbalaganskiy",
  "contributors": [],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "typings": "dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurelia-ui-toolkits/aurelia-gridstack.git",
    "directory": "packages/aurelia-gridstack"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build": "npm run build:js && npm run build:types",
    "publish:au2": "npm publish --tag au2"
  },
  "peerDependencies": {
    "aurelia": ">=2.0.0-rc.1",
    "gridstack": "^13.0.2"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
