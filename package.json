{
  "name": "@aurelia-gridstack/monorepo",
  "private": true,
  "version": "9.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/aurelia-gridstack",
    "start": "npm run start -w packages/demo",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "deploy": "npm run build -w packages/demo && bash deploy.sh",
    "publish:au2": "npm run publish:au2 -w packages/aurelia-gridstack"
  },
  "devDependencies": {
    "@aurelia/vite-plugin": "^2.0.0-rc.2",
    "@babel/core": "^8.0.6",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "aurelia": ">=2.0.0-rc.2",
    "eslint": "^10.11.0",
    "gridstack": "^14.0.0",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
