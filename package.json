{
  "name": "@aurelia-gridstack/monorepo",
  "private": true,
  "version": "5.0.0-au2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/aurelia-gridstack",
    "start": "npm run start -w packages/demo",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "deploy": "npm run build -w packages/demo && bash deploy.sh",
    "publish:au2": "npm run publish:au2 -w packages/aurelia-gridstack"
  },
  "devDependencies": {
    "@aurelia/vite-plugin": "^2.0.0-rc.1",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "aurelia": ">=2.0.0-rc.1",
    "eslint": "^10.8.0",
    "gridstack": "^13.0.2",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
